+						let mut socket = BufReader::new(socket);
+						let mut line = String::new();
+						socket.read_line(&mut line).await.unwrap();
+						let mut content_length = 0;
+						loop {
+							line.clear();
+							assert_ne!(socket.read_line(&mut line).await.unwrap(), 0);
+							if line == "\r\n" {
