+			JOIN bark_vtxo_key k ON k.public_key = p.public_key WHERE k.idx = ?1",
+		[index],
+		|row| row.get::<_, Vec<u8>>(0),
+	).optional()?;
+	bytes.map(|bytes| serde_json::from_slice(&bytes).map_err(Into::into)).transpose()
+}
