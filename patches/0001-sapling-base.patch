+//! One-use client signing sessions and bounded, non-redirecting JSON transport.
+
+#[cfg(not(target_arch = "wasm32"))]
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+use bitcoin::hex::DisplayHex;
+use bitcoin::secp256k1::{schnorr, PublicKey};
+use serde::{de::DeserializeOwned, Serialize};
+
+use ark::musig::{self, nested};
+use ark::musig::context::SigningInput;
+use ark::sapio::protocol::{
+	parse_nonce, parse_partial, FinishRequest, FinishResponse, OwnershipRequest,
+	PrepareRequest, PrepareResponse, SigningAction, SpendRequest, MAX_REQUEST_BYTES, SIGNING_PROTOCOL,
+};
+
+use crate::{Config, Wallet};
+use super::VtxoSigningKey;
+
+const HTTP_TIMEOUT_SECS: u64 = 30;
+
+pub(crate) fn endpoint_url(value: &str) -> Result<reqwest::Url> {
+	let url = reqwest::Url::parse(value).context("invalid program endpoint URL")?;
+	ensure!(url.username().is_empty() && url.password().is_none() && url.fragment().is_none(),
+		"program endpoint must not contain credentials or a fragment");
+	let loopback = url.host_str()
+		.and_then(|s| s.trim_matches(['[', ']']).parse::<std::net::IpAddr>().ok())
+		.is_some_and(|ip| ip.is_loopback());
+	ensure!(url.scheme() == "https" || (url.scheme() == "http" && loopback),
+		"program endpoint requires HTTPS, except literal loopback HTTP");
+	Ok(url)
+}
+
+pub(crate) struct ProgramTransport {
+	#[cfg(not(target_arch = "wasm32"))]
+	direct: reqwest::Client,
+	#[cfg(all(not(target_arch = "wasm32"), feature = "socks5-proxy"))]
+	proxied: Option<reqwest::Client>,
+}
+
+impl ProgramTransport {
+	pub(crate) fn new(config: &Config) -> Result<Self> {
+		#[cfg(not(target_arch = "wasm32"))]
+		let direct = reqwest::Client::builder()
+			.no_proxy()
+			.redirect(reqwest::redirect::Policy::none())
+			.timeout(Duration::from_secs(HTTP_TIMEOUT_SECS))
+			.build().context("building program HTTP client")?;
+		#[cfg(all(not(target_arch = "wasm32"), feature = "socks5-proxy"))]
+		let proxied = config.socks5_proxy.as_ref().map(|proxy| {
+			reqwest::Client::builder().no_proxy()
+				.proxy(reqwest::Proxy::all(proxy)?)
+				.redirect(reqwest::redirect::Policy::none())
+				.timeout(Duration::from_secs(HTTP_TIMEOUT_SECS)).build()
+		}).transpose().context("building proxied program HTTP client")?;
+		let _ = config;
+		Ok(Self {
+			#[cfg(not(target_arch = "wasm32"))]
+			direct,
+			#[cfg(all(not(target_arch = "wasm32"), feature = "socks5-proxy"))]
+			proxied,
+		})
+	}
+
+	async fn post<T: Serialize + ?Sized, R: DeserializeOwned>(
+		&self, config: &Config, url: &str, request: &T,
+	) -> Result<R> {
+		let url = endpoint_url(url)?;
+		let body = serde_json::to_vec(request)?;
+		ensure!(body.len() <= MAX_REQUEST_BYTES, "program request exceeds size limit");
+		#[cfg(not(target_arch = "wasm32"))]
+		{
+			let client = &self.direct;
+			#[cfg(feature = "socks5-proxy")]
+			let client = if crate::proxy::proxy_for_url(&config.socks5_proxy, url.as_str())?.is_some() {
+				self.proxied.as_ref().context("program proxy client unavailable")?
+			} else { client };
+			let _ = config;
+			let mut response = client.post(url).header("Content-Type", "application/json")
+				.body(body).send().await.context("contacting program service")?;
+			let status = response.status();
+			let mut bytes = Vec::new();
+			while let Some(chunk) = response.chunk().await? {
+				ensure!(bytes.len().saturating_add(chunk.len()) <= MAX_REQUEST_BYTES,
+					"program response exceeds size limit");
+				bytes.extend_from_slice(&chunk);
+			}
+			ensure!(status.is_success(), "program service rejected request ({status}): {}",
+				String::from_utf8_lossy(&bytes[..bytes.len().min(8192)]));
+			Ok(serde_json::from_slice(&bytes).context("invalid program service response")?)
+		}
+		#[cfg(all(target_arch = "wasm32", feature = "wasm-web"))]
+		{
+			let _ = config;
+			let body = String::from_utf8(body).expect("JSON serialization is UTF-8");
+			let text = browser_post(url.as_str(), &body, MAX_REQUEST_BYTES as u32,
+				(HTTP_TIMEOUT_SECS * 1000) as u32).await
+				.map_err(|error| anyhow!("program HTTP request failed: {error:?}"))?;
+			Ok(serde_json::from_str(&text).context("invalid program service response")?)
+		}
+		#[cfg(all(target_arch = "wasm32", not(feature = "wasm-web")))]
+		{
+			let _ = (config, url, body);
+			bail!("browser program transport requires the wasm-web feature")
+		}
+	}
+}
+
+#[cfg(all(target_arch = "wasm32", feature = "wasm-web"))]
+#[wasm_bindgen::prelude::wasm_bindgen(inline_js = "
+export async function barkProgramPost(url, body, limit, timeout) {
+	const controller = new AbortController();
+	const timer = setTimeout(() => controller.abort(), timeout);
+	try {
+		const response = await fetch(url, {method: 'POST', body,
+			headers: {'Content-Type': 'application/json'}, credentials: 'omit',
+			redirect: 'error', signal: controller.signal, cache: 'no-store'});
+		const chunks = []; let size = 0;
+		if (response.body) {
+			const reader = response.body.getReader();
+			for (;;) {
+				const {done, value} = await reader.read();
+				if (done) break;
+				size += value.byteLength;
+				if (size > limit) { controller.abort(); throw new Error('program response exceeds size limit'); }
+				chunks.push(value);
+			}
+		}
+		const bytes = new Uint8Array(size); let offset = 0;
+		for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.byteLength; }
+		const text = new TextDecoder('utf-8', {fatal: true}).decode(bytes);
+		if (!response.ok) throw new Error('program service rejected request (' + response.status + '): ' + text.slice(0, 8192));
+		return text;
+	} finally { clearTimeout(timer); }
+}
+")]
+extern "C" {
+	#[wasm_bindgen::prelude::wasm_bindgen(catch, js_name = barkProgramPost)]
+	async fn browser_post(url: &str, body: &str, limit: u32, timeout: u32)
+		-> std::result::Result<String, wasm_bindgen::JsValue>;
+}
+
+pub(crate) struct SignatureResult {
+	pub user_partial: musig::PartialSignature,
+	pub signature: Option<schnorr::Signature>,
+}
+
+pub(crate) struct PreparedSignature {
+	wallet: Wallet,
+	signer: PublicKey,
+	input: Option<SigningInput>,
+	state: PreparedState,
+}
+
+enum PreparedState {
+	Local {
+		nonce: musig::SecretNonce,
+		public: musig::PublicNonce,
+		message: [u8; 32],
+		participants: Vec<PublicKey>,
+		tweak: Option<[u8; 32]>,
+	},
+	Program {
+		nonce: nested::Nonce,
+		peer: nested::MemberNonce,
+		intent: nested::Intent,
+		session: bitcoin::hashes::sha256::Hash,
+		endpoint: String,
+	},
+}
+
+impl PreparedSignature {
+	pub fn public_nonce(&self) -> musig::PublicNonce {
+		match &self.state {
+			PreparedState::Local { public, .. } => *public,
+			PreparedState::Program { nonce, peer, intent, .. } =>
+				nested::aggregate_member_nonces(intent, &[nonce.public(), *peer])
+					.expect("member nonce aggregation was checked during preparation"),
+		}
+	}
+
+	pub async fn finish(
+		self,
+		key: &VtxoSigningKey,
+		server_nonce: Option<musig::PublicNonce>,
+		server_partial: Option<musig::PartialSignature>,
+	) -> Result<SignatureResult> {
+		ensure!(key.public_key() == self.signer, "signer changed after nonce preparation");
+		let ret = match self.state {
+			PreparedState::Program { nonce, peer, intent, session, endpoint } => {
+				let request = FinishRequest {
+					protocol: SIGNING_PROTOCOL.into(), session,
+					server_nonce: server_nonce.map(|n| n.serialize().to_lower_hex_string()),
+					server_partial: server_partial.map(|s| s.serialize().to_lower_hex_string()),
+				};
+				let response: FinishResponse = self.wallet.post_program_json(
+					&format!("{}/ark/finish", endpoint.trim_end_matches('/')), &request,
+				).await?;
+				ensure!(response.protocol == SIGNING_PROTOCOL, "unexpected program signing protocol");
+				let session = nested::Session::new(intent, [nonce.public(), peer], server_nonce)?;
+				if let Some(partial) = server_partial.as_ref() { session.verify_server(partial)?; }
+				let peer_partial = parse_partial(&response.program_partial)?;
+				session.verify_member(1, &peer_partial)?;
+				// U is last. The enclave has never received this share.
+				let user = nonce.sign(&key.user, &session)?;
+				let shares = [user, peer_partial];
+				let user_partial = session.combine_members(&shares)?;
+				let signature = if intent.server.is_none() || server_partial.is_some() {
+					Some(session.aggregate(&shares, server_partial.as_ref())?)
+				} else { None };
+				SignatureResult { user_partial, signature }
+			},
+			PreparedState::Local { nonce, public, message, participants, tweak } => {
+				let native = key.local_keypair().context("native nonce supplied to program signer")?;
+				let server_nonce = server_nonce.context("missing server nonce")?;
+				ensure!(participants.len() == 2, "unsupported native participant count");
+				let server = participants.iter().copied().find(|p| *p != self.signer)
+					.context("missing distinct server participant")?;
+				let cache = match tweak {
+					Some(tweak) => musig::tweaked_key_agg(participants.iter().copied(), tweak).0,
+					None => musig::key_agg(participants.iter().copied()),
+				};
+				let aggregate = musig::nonce_agg(&[&public, &server_nonce]);
+				let session = musig::Session::new(&cache, aggregate, &message);
+				if let Some(partial) = server_partial.as_ref() {
+					ensure!(session.partial_verify(&cache, partial, &server_nonce, musig::pubkey_to(server)),
+						"invalid server partial signature");
+				}
+				let user_partial = session.partial_sign(nonce, &musig::keypair_to(native), &cache);
+				ensure!(session.partial_verify(&cache, &user_partial, &public, musig::pubkey_to(self.signer)),
+					"invalid local partial signature");
+				let signature = server_partial.as_ref().map(|server| {
+					musig::sig_from(session.partial_sig_agg(&[&user_partial, server]).assume_valid())
+				});
+				SignatureResult { user_partial, signature }
+			},
+		};
+		if let (Some(input), Some(signature)) = (&self.input, &ret.signature) {
+			input.verify_signature(signature)?;
+		}
+		Ok(ret)
+	}
+}
+
+impl Wallet {
+	pub(crate) async fn post_program_json<T: Serialize + ?Sized, R: DeserializeOwned>(
+		&self, url: &str, request: &T,
+	) -> Result<R> {
+		let transport = self.inner.program_transport.get_or_try_init(|| async {
+			ProgramTransport::new(&self.inner.config)
+		}).await?;
+		transport.post(&self.inner.config, url, request).await
+	}
+
+	async fn prepare_program_signature(
+		&self, key: &VtxoSigningKey, action: SigningAction, input: Option<SigningInput>,
+	) -> Result<PreparedSignature> {
+		let descriptor = key.program().context("program signer required")?;
+		let intent = action.intent(&descriptor.program)?;
+		let nonce = nested::Nonce::new(intent, descriptor.program.user_pubkey)?;
+		let request = PrepareRequest {
+			protocol: SIGNING_PROTOCOL.into(), key: descriptor.program.clone(), action,
+			user_nonce: nonce.public().serialize().to_lower_hex_string(),
+		};
+		let response: PrepareResponse = self.post_program_json(
+			&format!("{}/ark/prepare", descriptor.endpoint.trim_end_matches('/')), &request,
+		).await?;
+		ensure!(response.protocol == SIGNING_PROTOCOL, "unexpected program signing protocol");
+		let peer = nested::MemberNonce::from_bytes(
+			intent, intent.members[1], parse_nonce(&response.program_nonce)?.serialize(),
+		)?;
+		nested::aggregate_member_nonces(&intent, &[nonce.public(), peer])?;
+		Ok(PreparedSignature {
+			wallet: self.clone(), signer: key.public_key(), input,
+			state: PreparedState::Program { nonce, peer, intent, session: response.session,
+				endpoint: descriptor.endpoint.clone() },
+		})
+	}
+
+	pub(crate) async fn prepare_vtxo_signature(
+		&self, key: &VtxoSigningKey, input: SigningInput,
+	) -> Result<PreparedSignature> {
+		let message = input.sighash()?;
+		ensure!(input.participants.contains(&key.public_key()), "key is not a signing participant");
+		if key.program().is_some() {
+			ensure!(input.participants.len() == 2, "program outer signing needs exactly two participants");
+			let server = input.participants.iter().copied().find(|p| *p != key.public_key())
+				.context("missing distinct outer server")?;
+			let witness = self.inner.config.sapio_witnesses.get(&key.public_key())
+				.cloned().unwrap_or_default();
+			let request = SpendRequest::from_input(&input, Some(server), witness)?;
+			self.prepare_program_signature(key, SigningAction::Spend { request }, Some(input)).await
+		} else {
+			let native = key.local_keypair().context("native signing key required")?;
+			let (nonce, public) = musig::nonce_pair_with_msg(native, &message);
+			let state = PreparedState::Local { nonce, public, message,
+				participants: input.participants.clone(), tweak: input.tweak };
+			Ok(PreparedSignature { wallet: self.clone(), signer: key.public_key(), input: Some(input), state })
+		}
+	}
+
+	pub(crate) async fn sign_program_claim(
+		&self, key: &VtxoSigningKey, input: SigningInput, witness: Vec<u8>,
+	) -> Result<schnorr::Signature> {
+		ensure!(key.program().is_some(), "program claim requires a program key");
+		let request = SpendRequest::from_input(&input, None, witness)?;
+		self.prepare_program_signature(key, SigningAction::Spend { request }, Some(input)).await?
+			.finish(key, None, None).await?.signature.context("missing joint recovery signature")
+	}
+
+	pub(crate) async fn sign_vtxo_ownership(
+		&self, key: &VtxoSigningKey, request: OwnershipRequest,
+	) -> Result<schnorr::Signature> {
+		if let Some(program) = key.program() {
+			request.message(&program.program)?;
+			self.prepare_program_signature(key, SigningAction::Ownership { request }, None).await?
+				.finish(key, None, None).await?.signature.context("missing joint ownership signature")
+		} else {
+			ensure!(request.input.user_pubkey() == key.public_key(), "ownership key mismatch");
+			let message = request.message_for_owner(key.public_key())?;
+			Ok(ark::SECP.sign_schnorr_with_aux_rand(&message, &key.user, &rand::random()))
+		}
+	}
+}
diff --git a/sdk/src/sapio/mod.rs b/sdk/src/sapio/mod.rs
new file mode 100644
index 0000000..699e225
--- /dev/null
+++ b/sdk/src/sapio/mod.rs
@@ -0,0 +1,159 @@
+//! Generic Sapio-backed VTXOs with independent user ownership and saved recovery.
+//!
+//! captaind sees the ordinary public key C = KeyAgg(U, S). The wallet stores U's
+//! derivation index and the exact attested-root/program descriptor, never C's
+//! private key. Construction templates do not override program authorization.
+
+pub(crate) mod client;
+pub mod receive;
+pub mod recovery;
+
+use std::borrow::Cow;
+use std::net::SocketAddr;
+
+use anyhow::{Context, Result};
+use bitcoin::bip32::Xpub;
+use bitcoin::secp256k1::{Keypair, PublicKey};
+
+use ark::sapio::program::{Program, ProgramKey};
+use ark::vtxo::VtxoRef;
+
+use crate::persist::models::{ProgramRecoveryTemplate, SerdeProgramKey};
+use crate::Wallet;
+
+pub(crate) use client::PreparedSignature;
+
+/// Complete policy and recovery construction for newly issued program keys.
+/// Obtain `root` from independently verified attestation of the expected image.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SapioConfig {
+	pub endpoint: String,
+	pub root: Xpub,
+	pub program: Program,
+	pub recovery: ProgramRecoveryTemplate,
+	#[serde(default)]
+	pub coordinator_url: Option<String>,
+	/// Separate receiving-only REST listener; never exposes wallet admin routes.
+	#[serde(default)]
+	pub receive_bind: Option<SocketAddr>,
+}
+
+impl SapioConfig {
+	pub fn validate(&self) -> Result<()> {
+		client::endpoint_url(&self.endpoint)?;
+		self.program.derive_public_key(&self.root)?;
+		ensure!(!self.recovery.outputs.is_empty(), "program recovery needs explicit outputs");
+		ensure!(self.recovery.witness.len() <= 65_536, "program evidence exceeds size limit");
+		if let Some(index) = self.recovery.remainder_output {
+			ensure!(index < self.recovery.outputs.len(), "recovery remainder output is out of range");
+		}
+		if let Some(url) = &self.coordinator_url { client::endpoint_url(url)?; }
+		ensure!(self.receive_bind.is_none() || self.coordinator_url.is_some(),
+			"program receiving listener requires its advertised coordinator URL");
+		Ok(())
+	}
+}
+
+/// A native key or the user's private participant in an immutable joint key.
+/// No conversion from a program handle to a native C keypair exists.
+pub(crate) struct VtxoSigningKey {
+	pub(super) user: Keypair,
+	public: PublicKey,
+	program: Option<SerdeProgramKey>,
+}
+
+impl From<Keypair> for VtxoSigningKey {
+	fn from(user: Keypair) -> Self {
+		Self { public: user.public_key(), user, program: None }
+	}
+}
+
+impl VtxoSigningKey {
+	pub fn public_key(&self) -> PublicKey { self.public }
+
+	pub fn local_keypair(&self) -> Option<&Keypair> {
+		if self.program.is_none() { Some(&self.user) } else { None }
+	}
+
+	pub fn program(&self) -> Option<&SerdeProgramKey> { self.program.as_ref() }
+
+	fn from_program(user: Keypair, program: SerdeProgramKey) -> Result<Self> {
+		ensure!(user.public_key() == program.program.user_pubkey,
+			"program descriptor does not match the wallet's user key");
+		let public = program.program.public_key()?;
+		Ok(Self { user, public, program: Some(program) })
+	}
+}
+
+impl Wallet {
+	pub(crate) async fn signing_key(&self, public: &PublicKey) -> Result<Option<VtxoSigningKey>> {
+		if let Some(program) = self.inner.db.get_program_key(public).await? {
+			ensure!(self.inner.db.get_public_key_idx(public).await? == Some(program.index),
+				"program key index mapping is inconsistent");
+			let user = self.inner.seed.derive_vtxo_keypair(program.index);
+			let key = VtxoSigningKey::from_program(user, program)?;
+			ensure!(key.public_key() == *public, "program key mapping is inconsistent");
+			Ok(Some(key))
+		} else {
+			Ok(self.pubkey_keypair(public).await?.map(|(_, key)| key.into()))
+		}
+	}
+
+	pub(crate) async fn vtxo_signing_key(&self, vtxo: impl VtxoRef) -> Result<VtxoSigningKey> {
+		let bare = match vtxo.as_bare_vtxo() {
+			Some(bare) => bare,
+			None => Cow::Owned(self.get_vtxo_by_id(vtxo.vtxo_id()).await?.vtxo),
+		};
+		self.signing_key(&bare.user_pubkey()).await?.context("VTXO ownership key not found")
+	}
+
+	pub(crate) async fn peek_signing_key(&self, index: u32) -> Result<VtxoSigningKey> {
+		if let Some(program) = self.inner.db.get_program_key_by_index(index).await? {
+			ensure!(program.index == index, "program derivation index mismatch");
+			VtxoSigningKey::from_program(self.inner.seed.derive_vtxo_keypair(index), program)
+		} else {
+			Ok(self.peek_keypair(index).await?.into())
+		}
+	}
+
+	pub(crate) async fn derive_store_next_signing_key(&self) -> Result<(VtxoSigningKey, u32)> {
+		let Some(config) = self.inner.config.sapio.as_ref() else {
+			let (key, index) = self.derive_store_next_keypair().await?;
+			return Ok((key.into(), index));
+		};
+		config.validate()?;
+		let (user, index) = self.peek_next_keypair().await?;
+		let program = SerdeProgramKey {
+			index,
+			program: ProgramKey { program: config.program.clone(), root: config.root,
+				user_pubkey: user.public_key() },
+			endpoint: config.endpoint.clone(),
+			recovery: config.recovery.clone(),
+		};
+		let key = VtxoSigningKey::from_program(user, program)?;
+		self.inner.db.store_program_key(key.program().expect("constructed program handle")).await?;
+		Ok((key, index))
+	}
+
+	pub(crate) async fn find_vtxo_signing_keys(
+		&self,
+		wanted: impl IntoIterator<Item = PublicKey>,
+		gap_limit: u32,
+	) -> Result<std::collections::HashMap<PublicKey, VtxoSigningKey>> {
+		let mut found = std::collections::HashMap::new();
+		let mut unknown = Vec::new();
+		for public in wanted {
+			if let Some(key) = self.signing_key(&public).await? {
+				found.insert(public, key);
+			} else {
+				unknown.push(public);
+			}
+		}
+		// Program descriptors and claims are mandatory backup material. Unknown
+		// raw aggregate keys cannot be reconstructed by a seed-only gap scan.
+		found.extend(self.find_vtxo_keypairs(unknown, gap_limit).await?
+			.into_iter().map(|(public, key)| (public, key.into())));
+		Ok(found)
+	}
+}
diff --git a/sdk/src/sapio/receive.rs b/sdk/src/sapio/receive.rs
new file mode 100644
index 0000000..72bf0ce
--- /dev/null
+++ b/sdk/src/sapio/receive.rs
@@ -0,0 +1,384 @@
+//! Coordinated delivery for program-backed addresses.
+//!
+//! The address has no mailbox fallback. Prepare persists an authorized recovery
+//! claim before the sender signs; commit accepts only that same claim and the
+//! complete signed VTXO. Receipts use U, never an arbitrary-message S signature.
+
+use std::collections::HashSet;
+use std::time::Duration;
+
+use anyhow::Context;
+use bitcoin::hashes::{sha256, Hash, HashEngine};
+use bitcoin::secp256k1::{schnorr, Message, PublicKey};
+use bitcoin::Network;
+use serde::{Deserialize, Serialize};
+
+use ark::address::VtxoDelivery;
+use ark::sapio::program::ProgramKey;
+use ark::vtxo::{policy::VtxoPolicyKind, Full};
+use ark::{Address, ProtocolEncoding, Vtxo};
+
+use crate::persist::models::{ProgramRecoveryRecord, SerdeProgramKey};
+use crate::sapio::recovery::{verify_program_recovery, verify_program_recovery_template};
+use crate::Wallet;
+
+const DELIVERY_TYPE: u8 = 0x53;
+const DELIVERY_MARKER: &[u8] = b"sapio-receive\0";
+const VERSION: u8 = 1;
+const MAX_URL_BYTES: usize = 2048;
+const MAX_PREPARED_PER_KEY: usize = 128;
+const RECEIVE_LOCK: &str = "sapio.receive";
+
+pub const MAX_RECEIVE_BODY_BYTES: usize = 1_048_576;
+pub const MAX_RECEIVE_VTXOS: usize = 16;
+pub const RECEIVE_TIMEOUT: Duration = Duration::from_secs(60);
+
+/// The HTTP wire request. VTXOs use the canonical protocol hex encoding.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ProgramReceiveRequest {
+	pub address: String,
+	pub vtxos: Vec<String>,
+}
+
+/// A durable preparation acknowledgement. The descriptor proves U and S aggregate
+/// to the address key. Each claim is independently checked, then U authenticates
+/// its binding to this address and these exact candidate outputs.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ProgramReceiveReceipt {
+	pub version: u8,
+	pub address: String,
+	pub candidates: Vec<String>,
+	pub program: ProgramKey,
+	pub recoveries: Vec<ProgramRecoveryRecord>,
+	pub signature: schnorr::Signature,
+}
+
+/// A commit acknowledgement binds the final signed bytes, not only their txids.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ProgramReceiveCommit {
+	pub version: u8,
+	pub address: String,
+	pub vtxos_hash: sha256::Hash,
+	pub program: ProgramKey,
+	pub signature: schnorr::Signature,
+}
+
+fn coordinator_url(value: &str) -> anyhow::Result<reqwest::Url> {
+	ensure!(value.len() <= MAX_URL_BYTES, "coordinator URL is too long");
+	let url = reqwest::Url::parse(value).context("invalid coordinator URL")?;
+	ensure!(url.host_str().is_some(), "coordinator URL needs a host");
+	ensure!(url.username().is_empty() && url.password().is_none()
+		&& url.query().is_none() && url.fragment().is_none(),
+		"coordinator URL must not contain credentials, a query or a fragment");
+	// Plain HTTP is restricted to literal loopback addresses for local listeners.
+	// A hostname such as localhost is not trusted to retain its DNS resolution.
+	let loopback = url.host_str().and_then(|s| s.trim_matches(['[', ']']).parse::<std::net::IpAddr>().ok())
+		.is_some_and(|ip| ip.is_loopback());
+	ensure!(url.scheme() == "https" || (url.scheme() == "http" && loopback),
+		"coordinator URL requires HTTPS (HTTP is allowed only on loopback)");
+	Ok(url)
+}
+
+fn delivery_url(address: &Address) -> anyhow::Result<Option<reqwest::Url>> {
+	let Some(data) = address.delivery().iter().find_map(|delivery| match delivery {
+		VtxoDelivery::Unknown { delivery_type: DELIVERY_TYPE, data } => Some(data),
+		_ => None,
+	}) else { return Ok(None) };
+	ensure!(address.delivery().len() == 1, "coordinated address must have no other delivery method");
+	ensure!(address.policy().policy_type() == VtxoPolicyKind::Pubkey,
+		"coordinated address must use a final pubkey policy");
+	let payload = data.strip_prefix(DELIVERY_MARKER).context("invalid coordinated delivery marker")?;
+	ensure!(payload.first() == Some(&VERSION), "unsupported coordinated delivery version");
+	let value = std::str::from_utf8(&payload[1..]).context("invalid coordinator URL encoding")?;
+	Ok(Some(coordinator_url(value)?))
+}
+
+pub fn is_coordinated_address(address: &Address) -> anyhow::Result<bool> {
+	Ok(delivery_url(address)?.is_some())
+}
+
+fn candidate_bytes(vtxos: &[Vtxo<Full>]) -> Vec<String> {
+	vtxos.iter().map(|v| v.to_bare().serialize_hex()).collect()
+}
+
+fn validate_candidates(address: &Address, vtxos: &[Vtxo<Full>]) -> anyhow::Result<()> {
+	ensure!(!vtxos.is_empty() && vtxos.len() <= MAX_RECEIVE_VTXOS,
+		"receive requires between 1 and {MAX_RECEIVE_VTXOS} VTXOs");
+	let mut seen = HashSet::with_capacity(vtxos.len());
+	for vtxo in vtxos {
+		ensure!(vtxo.policy() == address.policy(), "candidate policy differs from receive address");
+		ensure!(address.is_for_server(vtxo.server_pubkey()), "candidate belongs to another Ark server");
+		ensure!(vtxo.amount() > bitcoin::Amount::ZERO, "candidate amount must be positive");
+		ensure!(seen.insert(vtxo.point()), "duplicate receive candidate");
+	}
+	Ok(())
+}
+
+fn receipt_message(
+	address: &str,
+	candidates: &[String],
+	program: &ProgramKey,
+	recoveries: &[ProgramRecoveryRecord],
+) -> anyhow::Result<Message> {
+	// Serialize an explicit typed tuple. Ancestor witnesses are excluded because
+	// preparation intentionally precedes the sender's signatures. The claim and
+	// prevout are immutable; the candidate commits to the exact ancestry txids.
+	let claims = recoveries.iter().map(|r|
+		(r.controlled_outpoint, r.program_key, &r.claim, &r.prevout)
+	).collect::<Vec<_>>();
+	let bytes = serde_json::to_vec(&(VERSION, address, candidates, program, claims))?;
+	Ok(tagged_message(b"bark/sapio/receive/prepare/v1", &bytes))
+}
+
+fn tagged_message(tag: &[u8], bytes: &[u8]) -> Message {
+	let tag = sha256::Hash::hash(tag);
+	let mut engine = sha256::Hash::engine();
+	engine.input(tag.as_byte_array());
+	engine.input(tag.as_byte_array());
+	engine.input(bytes);
+	Message::from_digest(sha256::Hash::from_engine(engine).to_byte_array())
+}
+
+fn final_hash(vtxos: &[Vtxo<Full>]) -> sha256::Hash {
+	let mut engine = sha256::Hash::engine();
+	engine.input(&(vtxos.len() as u64).to_le_bytes());
+	for vtxo in vtxos {
+		let bytes = vtxo.serialize();
+		engine.input(&(bytes.len() as u64).to_le_bytes());
+		engine.input(&bytes);
+	}
+	sha256::Hash::from_engine(engine)
+}
+
+fn commit_message(address: &str, hash: sha256::Hash, program: &ProgramKey) -> anyhow::Result<Message> {
+	Ok(tagged_message(b"bark/sapio/receive/commit/v1",
+		&serde_json::to_vec(&(VERSION, address, hash, program))?))
+}
+
+impl ProgramReceiveRequest {
+	fn decode(&self) -> anyhow::Result<(Address, Vec<Vtxo<Full>>)> {
+		ensure!(self.address.len() <= 8192, "receive address is too long");
+		ensure!(!self.vtxos.is_empty() && self.vtxos.len() <= MAX_RECEIVE_VTXOS,
+			"invalid receive VTXO count");
+		let size = self.vtxos.iter().try_fold(self.address.len(), |size, v|
+			size.checked_add(v.len()).context("receive size overflow"))?;
+		ensure!(size <= MAX_RECEIVE_BODY_BYTES, "receive request is too large");
+		let address = self.address.parse::<Address>().context("invalid receive address")?;
+		ensure!(is_coordinated_address(&address)?, "address does not use coordinated delivery");
+		let vtxos = self.vtxos.iter().map(|hex| Vtxo::<Full>::deserialize_hex(hex)
+			.context("invalid receive VTXO encoding")).collect::<anyhow::Result<Vec<_>>>()?;
+		validate_candidates(&address, &vtxos)?;
+		Ok((address, vtxos))
+	}
+
+	fn new(address: &Address, vtxos: &[Vtxo<Full>]) -> Self {
+		Self { address: address.to_string(), vtxos: vtxos.iter().map(|v| v.serialize_hex()).collect() }
+	}
+}
+
+impl ProgramReceiveReceipt {
+	pub fn verify(&self, address: &Address, vtxos: &[Vtxo<Full>]) -> anyhow::Result<()> {
+		validate_candidates(address, vtxos)?;
+		ensure!(self.version == VERSION && self.address == address.to_string(), "receipt address/version mismatch");
+		ensure!(self.program.public_key()? == address.policy().user_pubkey(),
+			"receipt U and S do not aggregate to address key");
+		ensure!(self.candidates == candidate_bytes(vtxos) && self.recoveries.len() == vtxos.len(),
+			"receipt candidate mismatch");
+		for (vtxo, recovery) in vtxos.iter().zip(&self.recoveries) {
+			verify_program_recovery(vtxo, recovery, false).context("invalid receipt recovery claim")?;
+		}
+		let message = receipt_message(&self.address, &self.candidates, &self.program, &self.recoveries)?;
+		ark::SECP.verify_schnorr(&self.signature, &message, &self.program.user_pubkey.x_only_public_key().0)
+			.context("invalid receive preparation signature")
+	}
+}
+
+impl ProgramReceiveCommit {
+	pub fn verify(&self, address: &Address, vtxos: &[Vtxo<Full>]) -> anyhow::Result<()> {
+		ensure!(self.version == VERSION && self.address == address.to_string(), "commit address/version mismatch");
+		ensure!(self.program.public_key()? == address.policy().user_pubkey(), "commit ownership descriptor mismatch");
+		ensure!(self.vtxos_hash == final_hash(vtxos), "commit signed VTXO bytes mismatch");
+		ark::SECP.verify_schnorr(&self.signature,
+			&commit_message(&self.address, self.vtxos_hash, &self.program)?,
+			&self.program.user_pubkey.x_only_public_key().0,
+		).context("invalid receive commit signature")
+	}
+}
+
+impl Wallet {
+	/// Build an address from an already persisted program descriptor. The only
+	/// delivery option is the coordinated endpoint; no private C is needed.
+	pub(crate) fn coordinated_address(
+		&self, key: &SerdeProgramKey, network: Network, server_pubkey: PublicKey,
+	) -> anyhow::Result<Address> {
+		let url = self.inner.config.sapio.as_ref().and_then(|s| s.coordinator_url.as_deref())
+			.context("program addresses require sapio.coordinator_url")?;
+		let url = coordinator_url(url)?;
+		let mut data = Vec::with_capacity(DELIVERY_MARKER.len() + 1 + url.as_str().len());
+		data.extend_from_slice(DELIVERY_MARKER);
+		data.push(VERSION);
+		data.extend_from_slice(url.as_str().as_bytes());
+		Address::builder().testnet(network != Network::Bitcoin).server_pubkey(server_pubkey)
+			.pubkey_policy(key.program.public_key()?)
+			.delivery(VtxoDelivery::Unknown { delivery_type: DELIVERY_TYPE, data })
+			.into_address().context("failed to build coordinated address")
+	}
+
+	async fn receive_key(&self, address: &Address) -> anyhow::Result<SerdeProgramKey> {
+		let key = self.inner.db.get_program_key(&address.policy().user_pubkey()).await?
+			.context("receive address is not a stored program key")?;
+		let properties = self.properties().await?;
+		let server = properties.server_pubkey.context("wallet has no stored Ark server key")?;
+		ensure!(address.is_for_server(server) && address.is_testnet() == (properties.network != Network::Bitcoin),
+			"receive address belongs to another network or server");
+		ensure!(key.program.public_key()? == address.policy().user_pubkey(), "invalid stored program descriptor");
+		let user = self.inner.seed.derive_vtxo_keypair(key.index);
+		ensure!(user.public_key() == key.program.user_pubkey, "stored program user key differs from wallet key");
+		Ok(key)
+	}
+
+	async fn prepared_receive_records(
+		&self, key: &SerdeProgramKey, vtxos: &[Vtxo<Full>],
+	) -> anyhow::Result<Vec<ProgramRecoveryRecord>> {
+		let mut records = Vec::with_capacity(vtxos.len());
+		for vtxo in vtxos {
+			let record = self.inner.db.get_program_recovery(vtxo.point()).await?
+				.context("program receive was not prepared; refusing unsafe deposit")?;
+			verify_program_recovery(vtxo, &record, false)?;
+			verify_program_recovery_template(&record, key)?;
+			records.push(record);
+		}
+		Ok(records)
+	}
+
+	/// Prepare only exact future payments to stored program addresses. This API
+	/// exposes no balance, arbitrary digest, input signing, or administrative call.
+	pub async fn prepare_program_receive(
+		&self, request: ProgramReceiveRequest,
+	) -> anyhow::Result<ProgramReceiveReceipt> {
+		let (address, vtxos) = request.decode()?;
+		let _guard = self.inner.lock_manager.lock(RECEIVE_LOCK, RECEIVE_TIMEOUT).await?;
+		let key = self.receive_key(&address).await?;
+		let existing = self.inner.db.list_program_recoveries().await?;
+		let count = existing.iter().filter(|r| r.program_key == address.policy().user_pubkey()).count();
+		let new_count = vtxos.iter().filter(|v| !existing.iter().any(|r| r.controlled_outpoint == v.point())).count();
+		ensure!(new_count == 0 || count.saturating_add(new_count) <= MAX_PREPARED_PER_KEY,
+			"receive address preparation limit reached; use a new address");
+		for vtxo in &vtxos {
+			let anchor = self.inner.chain.get_tx(&vtxo.chain_anchor().txid).await?
+				.context("receive candidate chain anchor not found")?;
+			vtxo.validate_unsigned(&anchor).context("invalid receive candidate chain")?;
+		}
+		self.prepare_program_recoveries(&vtxos).await?;
+		let records = self.prepared_receive_records(&key, &vtxos).await?;
+		let candidates = candidate_bytes(&vtxos);
+		let address = address.to_string();
+		let message = receipt_message(&address, &candidates, &key.program, &records)?;
+		let user = self.inner.seed.derive_vtxo_keypair(key.index);
+		let signature = ark::SECP.sign_schnorr_no_aux_rand(&message, &user);
+		Ok(ProgramReceiveReceipt { version: VERSION, address, candidates,
+			program: key.program, recoveries: records, signature })
+	}
+
+	/// Commit a prepared receive without consulting Sapio or requesting another
+	/// signature. A lost response can be retried with identical signed VTXOs.
+	pub async fn commit_program_receive(
+		&self, request: ProgramReceiveRequest,
+	) -> anyhow::Result<ProgramReceiveCommit> {
+		let (address, vtxos) = request.decode()?;
+		let _guard = self.inner.lock_manager.lock(RECEIVE_LOCK, RECEIVE_TIMEOUT).await?;
+		let key = self.receive_key(&address).await?;
+		self.prepared_receive_records(&key, &vtxos).await?;
+		for vtxo in &vtxos {
+			self.validate_vtxo(vtxo).await.context("invalid final receive VTXO")?;
+			if let Some(stored) = self.inner.db.get_full_vtxo(vtxo.id()).await? {
+				ensure!(stored.serialize() == vtxo.serialize(), "receive retry differs from saved signed bytes");
+			}
+		}
+		self.ensure_program_recoveries(&vtxos).await?;
+		let hash = final_hash(&vtxos);
+		self.store_received_arkoor_package(vtxos).await?;
+		let address = address.to_string();
+		let user = self.inner.seed.derive_vtxo_keypair(key.index);
+		let signature = ark::SECP.sign_schnorr_no_aux_rand(&commit_message(&address, hash, &key.program)?, &user);
+		Ok(ProgramReceiveCommit { version: VERSION, address, vtxos_hash: hash, program: key.program, signature })
+	}
+
+	/// Require a verified, durable recipient recovery before the sender releases
+	/// its completed input signature. Native addresses need no handshake.
+	pub async fn prepare_program_receives(&self, address: &Address, vtxos: &[Vtxo<Full>]) -> anyhow::Result<()> {
+		let Some(url) = delivery_url(address)? else { return Ok(()) };
+		validate_candidates(address, vtxos)?;
+		let receipt: ProgramReceiveReceipt = receive_request(self, url, "prepare", &ProgramReceiveRequest::new(address, vtxos)).await?;
+		receipt.verify(address, vtxos)
+	}
+
+	/// Call only after the sender checkpoints the final signed VTXOs, before
+	/// registration/export. A rejected or unavailable commit never unlocks inputs.
+	pub async fn commit_program_receives(&self, address: &Address, vtxos: &[Vtxo<Full>]) -> anyhow::Result<()> {
+		let Some(url) = delivery_url(address)? else { return Ok(()) };
+		validate_candidates(address, vtxos)?;
+		let receipt: ProgramReceiveCommit = receive_request(self, url, "commit", &ProgramReceiveRequest::new(address, vtxos)).await?;
+		receipt.verify(address, vtxos)
+	}
+}
+
+async fn receive_request<T: serde::de::DeserializeOwned>(
+	wallet: &Wallet, mut url: reqwest::Url, phase: &str, request: &ProgramReceiveRequest,
+) -> anyhow::Result<T> {
+	let path = format!("{}/{}", url.path().trim_end_matches('/'), phase);
+	url.set_path(&path);
+	wallet.post_program_json(url.as_str(), request).await
+		.with_context(|| format!("receive coordinator {phase} failed"))
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	fn address_with_deliveries(delivery: Vec<VtxoDelivery>) -> Address {
+		let key: PublicKey = "0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798".parse().unwrap();
+		Address::new(true, key, ark::VtxoPolicy::new_pubkey(key), delivery)
+	}
+
+	fn coordinated_delivery(version: u8, url: &str) -> VtxoDelivery {
+		let mut data = DELIVERY_MARKER.to_vec();
+		data.push(version);
+		data.extend_from_slice(url.as_bytes());
+		VtxoDelivery::Unknown { delivery_type: DELIVERY_TYPE, data }
+	}
+
+	#[test]
+	fn coordinated_addresses_fail_closed_without_exclusive_supported_delivery() {
+		let delivery = coordinated_delivery(VERSION, "https://recipient.example/api/v1/receive/program");
+		let address = address_with_deliveries(vec![delivery.clone()]);
+		assert!(is_coordinated_address(&address).unwrap());
+		assert!(address.delivery().iter().all(VtxoDelivery::is_unknown));
+		let decoded: Address = address.to_string().parse().unwrap();
+		assert_eq!(delivery_url(&decoded).unwrap(), delivery_url(&address).unwrap());
+		assert!(is_coordinated_address(&address_with_deliveries(vec![delivery.clone(), delivery])).is_err());
+		assert!(is_coordinated_address(&address_with_deliveries(vec![
+			coordinated_delivery(VERSION + 1, "https://recipient.example"),
+		])).is_err());
+		assert!(!is_coordinated_address(&address_with_deliveries(Vec::new())).unwrap());
+	}
+
+	#[test]
+	fn coordinated_delivery_rejects_unsafe_url_authority() {
+		for url in [
+			"file:///etc/passwd", "ftp://recipient.example/receive",
+			"http://recipient.example/receive", "http://localhost/receive",
+			"https://user:secret@recipient.example/receive",
+			"https://recipient.example/receive?admin=true",
+			"https://recipient.example/receive#commit",
+		] {
+			assert!(coordinator_url(url).is_err(), "{url}");
+		}
+		assert!(coordinator_url("https://recipient.example/api/v1/receive/program").is_ok());
+		assert!(coordinator_url("http://127.0.0.1:8081/api/v1/receive/program").is_ok());
+		assert!(coordinator_url("http://[::1]:8081/api/v1/receive/program").is_ok());
+	}
+}
