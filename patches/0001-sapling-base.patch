+		let merged = merge_program_recovery(stored, record)?;
+		conn.execute(
+			"INSERT INTO bark_program_recovery (controlled_outpoint, record) VALUES (?1, ?2)
+				ON CONFLICT (controlled_outpoint) DO UPDATE SET record = excluded.record",
